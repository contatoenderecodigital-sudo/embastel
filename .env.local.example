# Copie este arquivo para ".env.local" — ele fica de fora do Git de propósito.
# Nenhuma variável é obrigatória pro painel abrir: cada uma liga um pedaço.
#
# No servidor o arquivo equivalente é /www/wwwroot/painel-embastel/.env, e ele
# NÃO é sobrescrito pelo deploy.

# ---------------------------------------------------------------------------
# ACESSO AO PAINEL
# ---------------------------------------------------------------------------
# Senha única de acesso. Enquanto estiver vazia, o painel abre sem pedir nada —
# tudo bem no seu computador, inaceitável na internet: sem ela, qualquer um com
# o link vê o cadastro de clientes com CNPJ, endereço e telefone.
PAINEL_SENHA=

# Senha da vendedora, para o celular dela na rua.
#
# Abre SÓ pedidos, clientes e comissão — e não recebe o custo dos produtos, só
# o preço de venda e o mínimo. Existe porque o celular que anda no carro e no
# balcão do cliente não pode carregar a chave do painel inteiro: se sumir,
# troca-se só esta senha, sem incomodar ninguém.
#
# Vazia, nada muda: continua existindo só a senha da casa.
PAINEL_SENHA_VENDEDORA=

# Segredo que assina o cookie de sessão. Qualquer texto longo e aleatório.
# Vazio, o painel assina com a própria PAINEL_SENHA.
#
# Com duas senhas em uso, vale preencher de verdade: sem ele o cookie é
# assinado com a senha da casa, e trocar a senha da casa derruba a sessão da
# vendedora junto.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# INTELIGÊNCIA ARTIFICIAL  (opcional)
# ---------------------------------------------------------------------------
# Liga três coisas que hoje estão dormindo: o "Resumir c/ IA" da licitação, a
# triagem automática ("a Embastel vende isso?") e a resposta automática do
# WhatsApp. Sem a chave, tudo continua funcionando — só sem essas três.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# WHATSAPP  (opcional — só pra quem for mexer no módulo de atendimento)
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token que você inventa e repete no painel da Meta, pra validar o webhook.
WHATSAPP_VERIFY_TOKEN=
# Só se precisar fixar outra versão da Graph API. Padrão: v21.0
WHATSAPP_GRAPH_VERSION=
