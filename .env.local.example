# Copie para ".env.local" (uso no seu computador) ou cadastre como Environment
# Variables no Vercel (uso em produção). Nenhuma delas é obrigatória para o
# painel abrir — cada uma liga um pedaço.

# ---------------------------------------------------------------------------
# BANCO DE DADOS  (obrigatório no Vercel, dispensável no seu computador)
# ---------------------------------------------------------------------------
# Sem esta variável o painel guarda tudo em arquivos na pasta data/, que é como
# ele funciona no seu computador. No Vercel isso NÃO funciona: o disco é
# somente leitura e some a cada requisição — lá o banco é obrigatório.
# Pegue a string de conexão em neon.tech (grátis) ou no Vercel Postgres.
DATABASE_URL=

# ---------------------------------------------------------------------------
# ACESSO AO PAINEL  (obrigatório no Vercel)
# ---------------------------------------------------------------------------
# Senha única de acesso. Enquanto estiver vazia, o painel abre sem pedir nada —
# aceitável no seu computador, inaceitável na internet: sem ela, qualquer um
# com o link vê o cadastro de clientes com CNPJ, endereço e telefone.
PAINEL_SENHA=

# Segredo usado para assinar o cookie de sessão. Pode ser qualquer texto longo
# e aleatório. Se ficar vazio, o painel assina com a própria PAINEL_SENHA.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# COLETA AUTOMÁTICA  (obrigatório no Vercel)
# ---------------------------------------------------------------------------
# Segredo que protege /api/cron/*. O Vercel manda ele sozinho nas chamadas
# agendadas; sem isso, qualquer um poderia disparar uma varredura do PNCP.
CRON_SECRET=

# ---------------------------------------------------------------------------
# INTELIGÊNCIA ARTIFICIAL  (opcional)
# ---------------------------------------------------------------------------
# Chave da Anthropic (console.anthropic.com > API Keys). Liga três coisas:
#  - a triagem que descarta licitação fora do ramo ("bolo de confeitaria",
#    "ureia em embalagens de 50kg", "sacola para corda");
#  - o "Resumir com IA" no funil de licitações;
#  - a resposta automática do WhatsApp.
# Sem ela, tudo isso fica desligado e o resto do painel funciona normalmente.
# O modelo usado é o Claude Haiku 4.5 — centavos por mês neste volume.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# WHATSAPP  (opcional)
# ---------------------------------------------------------------------------
# developers.facebook.com > seu app > WhatsApp > Configuração da API.

# Token de acesso permanente (ou temporário, que expira em 24h).
WHATSAPP_ACCESS_TOKEN=

# ID do número de telefone do WhatsApp Business (não é o número em si).
WHATSAPP_PHONE_NUMBER_ID=

# Token que você mesmo inventa e cadastra também no painel da Meta no Webhook.
WHATSAPP_VERIFY_TOKEN=

# Versão da Graph API (opcional, tem um valor padrão).
WHATSAPP_GRAPH_VERSION=v21.0
